{
  "name": "aplikacjasedziowska",
  "private": true,
  "version": "1.0.0",
  "description": "Aplikacja do nauki na egzamin wstępny na aplikację sędziowską (KSSiP): oficjalne testy, kazusy, ustawy z API Sejmu, kalkulator wynagrodzeń.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:acts": "tsx scripts/fetch-acts.ts",
    "data:questions": "tsx scripts/build-questions.ts",
    "data:all": "npm run data:acts && npm run data:questions"
  },
  "dependencies": {
    "pdfjs-dist": "5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
